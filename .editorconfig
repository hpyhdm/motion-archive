# Editor settings shared across IDEs
# IDE 공통 에디터 설정
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.js]
ij_javascript_spaces_within_imports = true
ij_javascript_spaces_within_object_literal_braces = true